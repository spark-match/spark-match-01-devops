{
  "version": 3,
  "schema": "spark-match.repository-governance/v3",
  "_notes": [
    {
      "date": "2026-07-13",
      "change": "Initial implementation. requireCodeOwnerReview=true enforces team reviewer requests via CODEOWNERS + this flag. The ruleset field required_reviewers is not available on the current GitHub plan."
    },
    {
      "date": "2026-08-01",
      "change": "Added 3 strict required checks for spark-match-02-infrastructure (tflint, gitleaks, sonar-terraform) after gap analysis revealed 3 PRs (#77/#78/#79) had bypassed tflint via admin-bypass. Tracked in tasks/devops/pending/sprint-2/03-strict-required-checks-and-admin-bypass-policy.md."
    },
    {
      "date": "2026-08-04",
      "change": "Reconciled spark-match-02-infrastructure statusChecks against actual reported check contexts. Manifest had 5 placeholder names (Plan (dev) / Plan (dev), tflint (env=dev), etc.) that did not match the 8 checks GitHub Actions actually reports (plan-dev / plan-, tflint / tflint-, etc.). Surfaced by --check returning drift. Fix: replaced 5 placeholders with the 8 real check contexts reported by /actions/runs/{id}/jobs API."
    }
  ],
  "defaults": {
    "approvals": 1,
    "dismissStaleReviews": true,
    "requireConversationResolution": true,
    "requireLastPushApproval": false,
    "requireCodeOwnerReview": true,
    "allowedMergeMethods": ["squash"],
    "adminBypassMode": "pull_request",
    "blockDeletion": true,
    "blockForcePush": true,
    "requireLinearHistory": true,
    "rulesetName": "spark-match-default-branch-protection",
    "rulesetTarget": "branch",
    "rulesetEnforcement": "active"
  },
  "repositories": {
    "spark-match-01-devops": {
      "refs": ["~DEFAULT_BRANCH"],
      "reviewerTeam": "devops",
      "filePatterns": ["**"],
      "statusChecks": [
        "actionlint / actionlint-ci",
        "gitleaks / gitleaks-ci",
        "yamllint / yamllint-ci"
      ]
    },
    "spark-match-07-article": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "article-authors",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-02-infrastructure": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "devops",
      "filePatterns": ["**"],
      "statusChecks": [
        "plan-dev / plan-",
        "Checkov",
        "tflint / tflint-",
        "gitleaks / gitleaks-",
        "sonar-terraform / sonar-terraform-dev",
        "terraform-validate / terraform-validate-",
        "quality / bats",
        "lint-commits / commitlint"
      ]
    },
    "spark-match-00-knowledge-base": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "tech-leads",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-03-backend": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "backend-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-04-frontend": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "frontend-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-05-data-pipeline": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "ai-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-06-model-training": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "ai-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-08-deep-agent": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "ai-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    }
  }
}
