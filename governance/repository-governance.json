{
  "version": 2,
  "schema": "spark-match.repository-governance/v2",
  "_note": "requireCodeOwnerReview=true: team reviewer requests are enforced via CODEOWNERS + this flag. The ruleset field required_reviewers is not available on the current GitHub plan. 2026-08-01: added 3 strict required checks for spark-match-02-infrastructure (tflint, gitleaks, sonar-terraform) after gap analysis revealed 3 PRs (#77/#78/#79) had bypassed tflint via admin-bypass. Tracked in tasks/devops/pending/sprint-2/03-strict-required-checks-and-admin-bypass-policy.md.",
  "defaults": {
    "approvals": 1,
    "dismissStaleReviews": true,
    "requireConversationResolution": true,
    "requireLastPushApproval": false,
    "requireCodeOwnerReview": true,
    "allowedMergeMethods": ["squash"],
    "adminBypassMode": "pull_request",
    "blockDeletion": true,
    "blockForcePush": true,
    "requireLinearHistory": true,
    "rulesetName": "spark-match-default-branch-protection",
    "rulesetTarget": "branch",
    "rulesetEnforcement": "active"
  },
  "repositories": {
    "spark-match-01-devops": {
      "refs": ["~DEFAULT_BRANCH"],
      "reviewerTeam": "devops",
      "filePatterns": ["**"],
      "statusChecks": [
        "actionlint / actionlint (env=ci)",
        "gitleaks / gitleaks (env=ci)",
        "yamllint / yamllint (env=ci)"
      ]
    },
    "spark-match-07-article": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "article-authors",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-02-infrastructure": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "devops",
      "filePatterns": ["**"],
      "statusChecks": [
        "Plan (dev) / Plan (dev)",
        "Checkov",
        "tflint / tflint (env=dev)",
        "gitleaks / gitleaks (env=dev)",
        "sonar-terraform / SonarCloud Terraform (dev)"
      ]
    },
    "spark-match-00-knowledge-base": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "tech-leads",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-03-backend": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "backend-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-04-frontend": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "frontend-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-05-data-pipeline": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "ai-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-06-model-training": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "ai-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    },
    "spark-match-08-deep-agent": {
      "refs": ["~DEFAULT_BRANCH", "refs/heads/dev"],
      "reviewerTeam": "ai-devs",
      "filePatterns": ["**"],
      "statusChecks": []
    }
  }
}
